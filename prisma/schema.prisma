generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model AdminUser {
  id String @id @default(cuid())
  username String @unique
  passwordHash String
  createdAt DateTime @default(now())
}
model Service {
  id String @id @default(cuid())
  name String
  description String?
  durationMinutes Int
  priceCents Int?
  active Boolean @default(true)
  sortOrder Int @default(0)
  bookings Booking[]
  staff StaffService[]
}
model Staff {
  id String @id @default(cuid())
  name String
  active Boolean @default(true)
  services StaffService[]
  hours BusinessHours[]
  bookings Booking[]
  occupancy Occupancy[]
}
model StaffService {
  staffId String
  serviceId String
  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  @@id([staffId, serviceId])
}
model BusinessHours {
  id String @id @default(cuid())
  staffId String
  weekday Int
  startMinute Int
  endMinute Int
  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  @@index([staffId, weekday])
}
model Booking {
  id String @id @default(cuid())
  code String @unique
  serviceId String
  staffId String
  customerName String
  phoneNormalized String
  startsAt DateTime @db.Timestamptz(3)
  endsAt DateTime @db.Timestamptz(3)
  status BookingStatus @default(confirmed)
  manageTokenHash String @unique
  idempotencyKey String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  service Service @relation(fields: [serviceId], references: [id])
  staff Staff @relation(fields: [staffId], references: [id])
  occupancy Occupancy?
  @@index([startsAt, status])
}
model TimeBlock {
  id String @id @default(cuid())
  staffId String
  startsAt DateTime @db.Timestamptz(3)
  endsAt DateTime @db.Timestamptz(3)
  reason String?
  active Boolean @default(true)
  occupancy Occupancy?
}
model Occupancy {
  id String @id @default(cuid())
  staffId String
  bookingId String? @unique
  blockId String? @unique
  startsAt DateTime @db.Timestamptz(3)
  endsAt DateTime @db.Timestamptz(3)
  active Boolean @default(true)
  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  block TimeBlock? @relation(fields: [blockId], references: [id], onDelete: Cascade)
  @@index([staffId, startsAt, endsAt])
}
model Settings {
  id Int @id @default(1)
  businessName String @default("Al Corte")
  publicPhone String?
  timezone String @default("America/Montevideo")
  currency String @default("UYU")
  minAdvanceMinutes Int @default(60)
  maxAdvanceDays Int @default(60)
  slotStepMinutes Int @default(15)
  cancellationPolicy String @default("Cancelá o cambiá tu hora con anticipación contactando al local.")
}
model RateLimit {
  key String @id
  hits Int
  resetAt DateTime @db.Timestamptz(3)
}
enum BookingStatus {
  confirmed
  cancelled
  completed
  no_show
}
