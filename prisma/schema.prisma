generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Business {
  id          String   @id @db.NVarChar(40)
  slug        String   @unique @db.NVarChar(63)
  status      String   @default("active") @db.NVarChar(16)
  createdAt   DateTime @default(now())
  adminUsers  AdminUser[]
  services    Service[]
  staff       Staff[]
  staffServices StaffService[]
  hours       BusinessHours[]
  bookings    Booking[]
  blocks      TimeBlock[]
  occupancy   Occupancy[]
  settings    Settings?
}

model AdminUser {
  id             String   @id @default(cuid()) @db.NVarChar(40)
  businessId     String   @db.NVarChar(40)
  username       String   @db.NVarChar(100)
  passwordHash   String   @db.NVarChar(255)
  active         Boolean  @default(true)
  sessionVersion Int      @default(1)
  createdAt      DateTime @default(now())
  business       Business @relation(fields: [businessId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@unique([username, businessId])
  @@unique([id, businessId])
  @@index([businessId, active])
}

model Service {
  id              String         @id @default(cuid()) @db.NVarChar(40)
  businessId      String         @db.NVarChar(40)
  name            String         @db.NVarChar(120)
  description     String?        @db.NVarChar(500)
  durationMinutes Int
  priceCents      Int?
  active          Boolean        @default(true)
  sortOrder       Int            @default(0)
  business        Business       @relation(fields: [businessId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  staff           StaffService[]
  bookings        Booking[]
  @@unique([id, businessId])
  @@index([businessId, active, sortOrder])
}

model Staff {
  id          String         @id @default(cuid()) @db.NVarChar(40)
  businessId  String         @db.NVarChar(40)
  name        String         @db.NVarChar(120)
  active      Boolean        @default(true)
  business    Business       @relation(fields: [businessId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  services    StaffService[]
  hours       BusinessHours[]
  bookings    Booking[]
  blocks      TimeBlock[]
  occupancy   Occupancy[]
  @@unique([id, businessId])
  @@index([businessId, active, name])
}

model StaffService {
  businessId String   @db.NVarChar(40)
  staffId    String   @db.NVarChar(40)
  serviceId  String   @db.NVarChar(40)
  business   Business @relation(fields: [businessId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  staff      Staff    @relation(fields: [staffId, businessId], references: [id, businessId], onDelete: NoAction, onUpdate: NoAction)
  service    Service  @relation(fields: [serviceId, businessId], references: [id, businessId], onDelete: NoAction, onUpdate: NoAction)
  @@id([businessId, staffId, serviceId])
  @@index([businessId, serviceId])
}

model BusinessHours {
  id          String   @id @default(cuid()) @db.NVarChar(40)
  businessId  String   @db.NVarChar(40)
  staffId     String   @db.NVarChar(40)
  weekday     Int
  startMinute Int
  endMinute   Int
  business    Business @relation(fields: [businessId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  staff       Staff    @relation(fields: [staffId, businessId], references: [id, businessId], onDelete: Cascade)
  @@index([businessId, staffId, weekday])
}

model Booking {
  id              String      @id @default(cuid()) @db.NVarChar(40)
  businessId      String      @db.NVarChar(40)
  code            String      @db.NVarChar(20)
  serviceId       String      @db.NVarChar(40)
  staffId         String      @db.NVarChar(40)
  customerName    String      @db.NVarChar(160)
  phoneNormalized String      @db.NVarChar(32)
  startsAt        DateTime    @db.DateTimeOffset
  endsAt          DateTime    @db.DateTimeOffset
  status          String      @default("confirmed") @db.NVarChar(20)
  manageTokenHash String      @unique @db.NVarChar(64)
  idempotencyKey  String      @db.NVarChar(100)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  business        Business    @relation(fields: [businessId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  service         Service     @relation(fields: [serviceId, businessId], references: [id, businessId], onDelete: NoAction)
  staff           Staff       @relation(fields: [staffId, businessId], references: [id, businessId], onDelete: NoAction, onUpdate: NoAction)
  occupancy       Occupancy[]
  @@unique([code, businessId])
  @@unique([idempotencyKey, businessId])
  @@unique([id, businessId])
  @@unique([id, staffId, businessId])
  @@index([businessId, startsAt, status])
}

model TimeBlock {
  id         String      @id @default(cuid()) @db.NVarChar(40)
  businessId String      @db.NVarChar(40)
  staffId    String      @db.NVarChar(40)
  startsAt   DateTime    @db.DateTimeOffset
  endsAt     DateTime    @db.DateTimeOffset
  reason     String?     @db.NVarChar(250)
  active     Boolean     @default(true)
  business   Business    @relation(fields: [businessId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  staff      Staff       @relation(fields: [staffId, businessId], references: [id, businessId], onDelete: Cascade, onUpdate: NoAction)
  occupancy  Occupancy[]
  @@unique([id, businessId])
  @@unique([id, staffId, businessId])
  @@index([businessId, staffId, startsAt, endsAt])
}

model Occupancy {
  id        String    @id @default(cuid()) @db.NVarChar(40)
  businessId String   @db.NVarChar(40)
  staffId   String    @db.NVarChar(40)
  bookingId String?   @db.NVarChar(40)
  blockId   String?   @db.NVarChar(40)
  startsAt  DateTime  @db.DateTimeOffset
  endsAt    DateTime  @db.DateTimeOffset
  active    Boolean   @default(true)
  business  Business  @relation(fields: [businessId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  staff     Staff     @relation(fields: [staffId, businessId], references: [id, businessId], onDelete: NoAction, onUpdate: NoAction)
  booking   Booking?  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  block     TimeBlock? @relation(fields: [blockId], references: [id], onDelete: Cascade)
  @@unique([bookingId, blockId, businessId])
  @@index([businessId, staffId, startsAt, endsAt])
}

model Settings {
  businessId           String   @id @db.NVarChar(40)
  businessName          String   @default("Al Corte") @db.NVarChar(120)
  publicPhone           String?  @db.NVarChar(32)
  timezone              String   @default("America/Montevideo") @db.NVarChar(64)
  currency              String   @default("UYU") @db.NVarChar(3)
  minAdvanceMinutes     Int      @default(60)
  maxAdvanceDays        Int      @default(60)
  slotStepMinutes       Int      @default(15)
  cancellationPolicy    String   @default("Cancelá o cambiá tu hora con anticipación contactando al local.") @db.NVarChar(500)
  business              Business @relation(fields: [businessId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model RateLimit {
  key     String   @id @db.NVarChar(160)
  hits    Int
  resetAt DateTime @db.DateTimeOffset
}
